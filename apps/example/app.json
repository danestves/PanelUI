{
  "expo": {
    "name": "PanelUI",
    "slug": "panelui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "khalid.panelui.com",
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "package": "khalid.panelui.com",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "panelui",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "PanelUI uses the microphone so the Soundwave demos can react to your voice."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PanelUI uses your location so the Map demos can recentre on where you are."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
